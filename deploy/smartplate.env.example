# Copy to deploy/smartplate.env ON THE SERVER (or enter the same names in your host's secret manager) and fill in values.
# Never commit the filled-in file, never put keys in the frontend, never bake them into the image.

# --- required in production
ENVIRONMENT=production
# Same-origin deployment (the image serves the frontend): leave as the public URL of the site.
CORS_ORIGINS=https://your-domain.example
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# --- optional external services (leave empty to disable; the app reports what is unavailable)
USDA_FDC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
# Set to false to never send photos to a provider.
OPENAI_VISION_ENABLED=true
GEMINI_VISION_ENABLED=true
VISION_ENABLED=true
OPENFOODFACTS_ENABLED=true
PUBCHEM_ENABLED=true

# --- abuse limits (on by default with ENVIRONMENT=production; the values below are the defaults)
# Anonymous visitors get the image model only; OpenAI/Gemini/Google Vision, AI label reading and the chatbot need an account.
PAID_PROVIDERS_REQUIRE_LOGIN=true
RATE_LIMITS_ENABLED=true
RATE_LIMIT_ANON_ANALYSES_PER_HOUR=10
RATE_LIMIT_USER_ANALYSES_PER_HOUR=30
RATE_LIMIT_USER_ANALYSES_PER_DAY=200
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_SIGNUPS_PER_HOUR=5
RATE_LIMIT_LOGINS_PER_HOUR=30
RATE_LIMIT_LOOKUPS_PER_HOUR=300
# Global daily request caps per paid provider (UTC day, all users together). 0 = never call it.
# These cap requests, not money: also set a budget alert / spending limit in the OpenAI and Google Cloud consoles.
OPENAI_DAILY_LIMIT=300
GEMINI_DAILY_LIMIT=300
GOOGLE_VISION_DAILY_LIMIT=300
CHAT_DAILY_LIMIT=500
MAX_REQUEST_MB=30
MAX_JSON_KB=1024
MAX_CONCURRENT_ANALYSES=3
