# Copy to .env and edit. Never commit .env. Keep credentials private.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini chatbot and meal planner (server-side only)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_S=30

# Optional external services and local data
GOOGLE_VISION_API_KEY=
VISION_ENABLED=true
VISION_MIN_SCORE=0.70
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_ENABLED=true
OPENAI_VISION_TIMEOUT_S=30
# When OpenAI fails: threshold (70% rule, default) | confirm (always ask) | fallback
OPENAI_FAILURE_POLICY=threshold
# Gemini food identification when OpenAI cannot answer (uses GEMINI_API_KEY). false = never send food photos to Gemini
GEMINI_VISION_ENABLED=true
GEMINI_VISION_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest
OPENFOODFACTS_ENABLED=true
PUBCHEM_ENABLED=true
USDA_FDC_API_KEY=
HTTP_TIMEOUT_S=8
TESSERACT_CMD=
PACKAGED_FOODS_CSV=
PACKAGED_ADDITIVES_CSV=
ADDITIVE_REFERENCE_CSV=

# Authentication cookie settings (Secure defaults off in development and on in production)
# AUTH_COOKIE_SECURE=
# AUTH_COOKIE_SAMESITE=lax
# AUTH_SESSION_DAYS=30
# Abuse limits for a public deployment. "auto" = on when ENVIRONMENT=production, off in local development.
# PAID_PROVIDERS_REQUIRE_LOGIN=auto   # anonymous visitors: image model only (no OpenAI/Gemini/Vision/chat)
# RATE_LIMITS_ENABLED=auto            # per-account / per-IP limits below (HTTP 429 with Retry-After)
# RATE_LIMIT_ANON_ANALYSES_PER_HOUR=10
# RATE_LIMIT_USER_ANALYSES_PER_HOUR=30
# RATE_LIMIT_USER_ANALYSES_PER_DAY=200
# RATE_LIMIT_CHAT_PER_HOUR=30
# RATE_LIMIT_SIGNUPS_PER_HOUR=5
# RATE_LIMIT_LOGINS_PER_HOUR=30
# RATE_LIMIT_LOOKUPS_PER_HOUR=300
# Always on: global daily request caps per paid provider (UTC day; 0 = never call it) and request/load limits.
# OPENAI_DAILY_LIMIT=300
# GEMINI_DAILY_LIMIT=300
# GOOGLE_VISION_DAILY_LIMIT=300
# CHAT_DAILY_LIMIT=500
# MAX_REQUEST_MB=30
# MAX_JSON_KB=1024
# MAX_CONCURRENT_ANALYSES=3
# USAGE_DATABASE_PATH=                # default: smartplate_usage.db next to DATABASE_PATH
