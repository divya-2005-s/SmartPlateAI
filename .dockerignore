# Keep secrets, local data and large folders out of the build context. The Dockerfile copies only what it needs.
**/.env
**/.env.*
**/*.env
!deploy/smartplate.env.example
**/.venv
**/.venv-*
**/*.bak
**/node_modules
**/__pycache__
**/*.pyc
**/dist
backups
_backup_*
_claude_v3_versions_*
pip-temp
backend/data
backend/data_*
backend/reports
backend/tests
backend/models/production/*.bak
backend/models/runs
frontend/tests
*.log
